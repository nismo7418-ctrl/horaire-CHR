# Copier ce fichier dans `.streamlit/secrets.toml` (jamais commité, cf. .gitignore).
# Les mêmes clés peuvent aussi être fournies en variables d'environnement
# (les variables d'environnement ont la priorité).

# ── Connexion à l'app (obligatoire) ─────────────────────────────────────
APP_IDENTIFIANT = "planificateur"
# Générer la valeur avec :
#   python -c "import auth; print(auth.hacher('votre-mot-de-passe'))"
APP_MDP_STOCKAGE = "pbkdf2_sha256$390000$<sel_hex>$<digest_hex>"

# ── Endpoint LLM (optionnel — défauts dans llm.py) ──────────────────────
# En cloud : pointer vers l'hôte de modèle dédié, sur le réseau privé, en HTTPS.
# LMSTUDIO_URL = "https://llm.interne/v1/chat/completions"
# LMSTUDIO_MODELE = "qwen3.8-27b"

# ── Session (variable d'environnement, pas besoin ici) ──────────────────
# APP_SESSION_TIMEOUT_S = 1800   # 30 min d'inactivité
